{
  "manifest_version": 3,
  "name": "wearehere",
  "version": "2.0.0",
  "description": "Full privacy scan for every site you visit. Cookies, trackers, fingerprinting, dark patterns, terms toxicity, network traffic, form leaks — one popup, complete picture.",
  "permissions": ["activeTab", "storage", "cookies", "webRequest"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [{
    "resources": ["report.html"],
    "matches": ["<all_urls>"]
  }]
}
